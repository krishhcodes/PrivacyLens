# Copy to .env.local and adjust. Only VITE_* variables reach the browser; never put secrets here.

# ConsentScope backend, no trailing slash. Default when unset: http://127.0.0.1:8000
VITE_API_BASE=http://127.0.0.1:8000

# Accounts (optional). Leave both unset for local mode: no sign-in, one shared local user.
# Supabase → Project Settings → API: the project URL and the *publishable* key (never the secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
